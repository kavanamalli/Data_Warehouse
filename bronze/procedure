CREATE OR REPLACE PROCEDURE bronze.load_bronze()
LANGUAGE plpgsql
AS $$
DECLARE
	start_time TIMESTAMP;
	end_time TIMESTAMP;
BEGIN
	
	
	RAISE NOTICE '=====================================';
	RAISE NOTICE 'Loading Bronze Layer';
	RAISE NOTICE '=====================================';

	RAISE NOTICE'--------------------------------------';
	RAISE NOTICE 'Loading CRM tables';
	RAISE NOTICE'--------------------------------------';
	
	--first table

	start_time := clock_timestamp();
	RAISE NOTICE 'bronze.crm_cust_info Load Started At: %', start_time;

	TRUNCATE bronze.crm_cust_info;
	COPY bronze.crm_cust_info
	FROM 'D:\Data Warehouse\datasets\source_crm\cust_info.csv'
	WITH (
		FORMAT CSV,
		HEADER TRUE,
		DELIMITER ','
	);
	end_time := clock_timestamp();
	RAISE NOTICE 'bronze.crm_cust_info Load Completed At: %', end_time;
	RAISE NOTICE 'Total bronze.crm_cust_info Load Duration: %', start_time - end_time;
	RAISE NOTICE '--------------------------------';


	
	
	--second table
	start_time := clock_timestamp();
	RAISE NOTICE 'bronze.crm_prd_info Load Started At: %', start_time;
	TRUNCATE bronze.crm_prd_info;
	
	COPY bronze.crm_prd_info
	FROM 'D:\Data Warehouse\datasets\source_crm\prd_info.csv'
	WITH (
		FORMAT CSV,
		HEADER TRUE,
		DELIMITER ','
	);
	end_time := clock_timestamp();
	RAISE NOTICE 'bronze.crm_prd_info Load Completed At: %', end_time;
	RAISE NOTICE 'Total bronze.crm_prd_info Load Duration: %', start_time - end_time;
	RAISE NOTICE '--------------------------------';
	
	
	
	--third table
	start_time := clock_timestamp();
	RAISE NOTICE 'bronze.crm_sales_details Load Started At: %', start_time;
	TRUNCATE bronze.crm_sales_details;
	
	COPY bronze.crm_sales_details
	FROM 'D:\Data Warehouse\datasets\source_crm\sales_details.csv'
	WITH (
		FORMAT CSV,
		HEADER TRUE,
		DELIMITER ','
	);
	end_time := clock_timestamp();
	RAISE NOTICE 'bronze.crm_sales_details Load Completed At: %', end_time;
	RAISE NOTICE 'Total bronze.crm_sales_details Load Duration: %', start_time - end_time;
	RAISE NOTICE '--------------------------------';
	
	RAISE NOTICE'--------------------------------------';
	RAISE NOTICE 'Loading ERP Tables';
	RAISE NOTICE'--------------------------------------';
	
	
	--fourth table
	start_time := clock_timestamp();
	RAISE NOTICE 'bronze.erp_loc_az12 Load Started At: %', start_time;
	
	TRUNCATE bronze.erp_loc_az12;
	COPY bronze.erp_loc_az12
	FROM 'D:\Data Warehouse\datasets\source_erp\CUST_AZ12.csv'
	WITH (
		FORMAT CSV,
		HEADER TRUE,
		DELIMITER ','
	);
	end_time := clock_timestamp();
	RAISE NOTICE 'bronze.erp_loc_az12 Load Completed At: %', end_time;
	RAISE NOTICE 'Total bronze.erp_loc_az12 Load Duration: %', start_time - end_time;
	RAISE NOTICE '--------------------------------';
	
	
	
	--fifth table
	start_time := clock_timestamp();
	RAISE NOTICE 'bronze.erp_loc_a101 Load Started At: %', start_time;
	
	TRUNCATE bronze.erp_loc_a101;
	COPY bronze.erp_loc_a101
	FROM 'D:\Data Warehouse\datasets\source_erp\LOC_A101.csv'
	WITH (
		FORMAT CSV,
		HEADER TRUE,
		DELIMITER ','
	);
	end_time := clock_timestamp();
	RAISE NOTICE 'bronze.erp_loc_a101 Load Completed At: %', end_time;
	RAISE NOTICE 'Total bronze.erp_loc_a101 Load Duration: %', start_time - end_time;
	RAISE NOTICE '--------------------------------';
	
	
	
	
	--sixth table 
	start_time := clock_timestamp();
	RAISE NOTICE 'bronze.erp_px_cat_g1v2 Load Started At: %', start_time;
	
	TRUNCATE bronze.erp_px_cat_g1v2;
	COPY bronze.erp_px_cat_g1v2
	FROM 'D:\Data Warehouse\datasets\source_erp\PX_CAT_G1V2.csv'
	WITH (
		FORMAT CSV,
		HEADER TRUE,
		DELIMITER ','
	);
	end_time := clock_timestamp();
	RAISE NOTICE 'bronze.erp_px_cat_g1v2 Load Completed At: %', end_time;
	RAISE NOTICE 'Total bronze.erp_px_cat_g1v2 Load Duration: %', start_time - end_time;
	RAISE NOTICE '--------------------------------';

	EXCEPTION
	WHEN OTHERS THEN
	RAISE NOTICE 'Bronze layer failed';
	RAISE NOTICE 'Error Code: %', SQLSTATE;
    RAISE NOTICE 'Error Message: %', SQLERRM;

END;
$$;



